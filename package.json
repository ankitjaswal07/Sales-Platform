    "jose": "^6.2.12",
    "lucide-react": "^0.474.0",
    "next": "^15.5.27",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
