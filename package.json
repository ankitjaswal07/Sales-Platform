{
  "name": "leadforge",
  "version": "1.0.0",
  "private": true,
  "description": "LeadForge \u2014 AI-powered website lead generation, prospecting, proposal & sales management platform for web development agencies.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:reset": "node --experimental-strip-types --conditions=react-server --import ./scripts/register.mjs scripts/db-reset.ts",
    "db:seed": "node --experimental-strip-types --conditions=react-server --import ./scripts/register.mjs scripts/db-seed.ts",
    "test": "node --experimental-strip-types --conditions=react-server --import ./scripts/register.mjs scripts/run-checks.ts",
    "jobs:tick": "node --experimental-strip-types --conditions=react-server --import ./scripts/register.mjs scripts/jobs-tick.ts",
    "start:passenger": "node server.js",
    "wp:package": "node scripts/wp-package.mjs",
    "wp:lint": "node scripts/wp-lint.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
