# ─────────────────────────────────────────────────────────────────────────────
# LeadForge — environment configuration
# Copy to `.env.local` and fill in what you need.
# Every integration is OPTIONAL: the platform fully runs with zero credentials
# using the embedded SQLite store and the deterministic local AI engine.
# The Integrations + Diagnostics screens show live connection state for each one.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Public URL of this instance. Used in share links, emails and proposal URLs.
APP_URL=http://localhost:3000
# 32+ char secret used to sign session cookies and webhook signatures.
# Generate with: node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
AUTH_SECRET=dev-only-insecure-secret-change-me-please-0123456789
SESSION_TTL_HOURS=720

# ── Database ─────────────────────────────────────────────────────────────────
# Embedded SQLite (zero-config default). Path is relative to the repo root.
# The directory must exist and be writable by the Node process.
DATABASE_PATH=data/leadforge.db
# NOTE: only the SQLite driver is implemented today. A Postgres/Prisma port is
# planned; until it lands, DATABASE_URL is not read by anything.
DATABASE_DRIVER=sqlite

# ── Cache / queue ────────────────────────────────────────────────────────────
# Jobs run on a durable queue stored in the database.
# WORKER_ENABLED=true  → the Node process runs the queue itself (VPS/Docker).
# WORKER_ENABLED=false → something external drains it: cron calling
#                        POST /api/jobs/tick, or `npm run jobs:tick`.
#                        Use this on hosting that stops idle processes (cPanel/Passenger).
WORKER_ENABLED=true
WORKER_INTERVAL_MS=2500
WORKER_CONCURRENCY=3

# Shared secret for POST /api/jobs/tick. Required in production when
# WORKER_ENABLED=false. Generate with:
#   node -e "console.log(crypto.randomBytes(24).toString('base64url'))"
CRON_SECRET=

# ── AI provider (abstracted) ─────────────────────────────────────────────────
# local | openai | anthropic | azure-openai | openrouter
AI_PROVIDER=local
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.4

# ── Business discovery providers (public / licensed data only) ───────────────
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=
HERE_API_KEY=
OPENCORPORATES_API_KEY=
# Absolute ceiling used by the discovery engine to respect provider quotas.
DISCOVERY_MAX_RESULTS_PER_JOB=250

# ── Website intelligence (audit engine) ──────────────────────────────────────
# PageSpeed Insights is optional; the built-in engine performs its own
# real-time HTTP fetch, DOM analysis and asset measurement when unset.
PAGESPEED_API_KEY=
AUDIT_USER_AGENT=LeadForgeBot/1.0 (+https://leadforge.example/bot)
AUDIT_TIMEOUT_MS=12000
AUDIT_MAX_PAGES=12

# ── Transactional email ──────────────────────────────────────────────────────
EMAIL_PROVIDER=console
EMAIL_FROM="LeadForge <hello@leadforge.example>"
EMAIL_REPLY_TO=
RESEND_API_KEY=
SENDGRID_API_KEY=
POSTMARK_TOKEN=
SMTP_URL=

# ── WhatsApp Business (official Cloud API only) ──────────────────────────────
WHATSAPP_PROVIDER=none
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ALERT_TO=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── Object storage (screenshots, proposal PDFs, exports) ─────────────────────
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── WordPress connector (optional) ───────────────────────────────────────────
# Enables signed sign-in from a WordPress site. Must match the "Shared secret"
# in the LeadForge Connector plugin's settings. Generate with:
#   openssl rand -base64 32
# The relevant endpoints stay closed (HTTP 503) until this is set.
WORDPRESS_CONNECTOR_SECRET=

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=

# ── Safety limits (anti-abuse) ───────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
OUTREACH_DAILY_SEND_CAP=400
OUTREACH_REQUIRE_APPROVAL=true

# ── Demo / seeding ───────────────────────────────────────────────────────────
# `npm run db:seed` builds a demo workspace: organisation "Northlight Studio",
# 8 users (login alex@northlight.studio), 96 businesses, leads, audits, proposals.
# In Docker, an empty volume is seeded automatically on first start.
SEED_DEMO_DATA=true
# Password for every seeded demo user. If unset, "leadforge-demo" is used —
# never leave that default in place on an internet-facing instance.
SEED_PASSWORD=
